# ════════════════════════════════════════════════════════════════════════════
#  جسر إلى الصين — environment
#
#  Copy to `.env.local` and fill in. Everything here is OPTIONAL: with none of
#  it set the platform still builds, still serves every lesson page, and still
#  runs the whole learning path from the browser's own storage. What it loses is
#  accounts, sync and payment — which is exactly the state it shipped in before
#  this layer existed, so a missing variable degrades the platform instead of
#  breaking it.
#
#  THERE IS NO PRICE IN THIS FILE, and there must never be one. The price lives
#  in the `app_config` table and is edited from the admin panel. Putting it in
#  an env var would mean a redeploy to change it and two places to disagree.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────────
# From the project's Settings → API. The first two are public by design and are
# sent to the browser; the third MUST NOT be.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: bypasses row-level security completely. Server-only, and the
# code throws if anything tries to read it in the browser. Never expose it,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── The first admin ─────────────────────────────────────────────────────────
# Comma-separated emails allowed to promote themselves to admin ONCE, through
# POST /api/admin/bootstrap. Clear this after the first admin exists: it is a
# door that only needs to open a single time.
ADMIN_BOOTSTRAP_EMAILS=

# ── Payment gateway ─────────────────────────────────────────────────────────
# Which provider is live is chosen in the ADMIN PANEL, not here. These are the
# secrets it needs once chosen; a provider selected without its secrets present
# stays off, so checkout can never half-work.
#
# Neither provider is required. Activation codes are the platform's first
# revenue path and need none of this.
#
# Note on eligibility: no gateway onboards a seller in Yemen. Both of the
# options below accept an Egyptian account, and both are merchants of record —
# they collect the tax in the buyer's country and pay out to one bank account,
# which is what makes selling into Yemen, Egypt, China and Russia from one
# store possible at all.

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# One variant id per plan, from the product page. Set only the plans you sell.
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_ANNUAL=
LEMONSQUEEZY_VARIANT_LIFETIME=

# Paddle — https://vendors.paddle.com/authentication-v2
# A key beginning `pdl_sdbx_` automatically targets the sandbox host.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_ANNUAL=
PADDLE_PRICE_LIFETIME=

# ── Webhook endpoints to register with the provider ─────────────────────────
#   Lemon Squeezy → https://<your-domain>/api/webhook/lemonsqueezy
#   Paddle        → https://<your-domain>/api/webhook/paddle
# Subscribe to the subscription lifecycle events only. Deliveries are verified
# against the secret above and rejected with 401 if the signature does not
# match, so an endpoint left registered after a key rotation fails closed.

# ── AI tutor (optional) ─────────────────────────────────────────────────────
# The rule engine answers common questions with no key and no cost. This is for
# the model that handles what the rules cannot; without it the tutor stays on
# the rule engine rather than erroring.
ANTHROPIC_API_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, OpenGraph and OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://moehsk1.vercel.app
