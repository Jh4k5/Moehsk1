# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never, the template always.
# `.env*` on its own also ignored `.env.example`, which is the one env file that
# has to be committed: it is how anyone else learns which variables exist.
.env*
!.env.example

