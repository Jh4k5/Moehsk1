@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

/* ═══════════════════════════════════════════════════════════
   Duolingo-Inspired Gamification Design Tokens
   ═══════════════════════════════════════════════════════════ */
:root {
  --radius: 0.75rem;

  /* Primary Gamification Colors — Blue Identity */
  --primary-blue: #1A5FA8;
  --primary-blue-dark: #0D4E82;
  --primary-blue-light: #E8F0FA;
  --primary-blue-glow: rgba(26, 95, 168, 0.25);

  /* Semantic Gamification Signals */
  --gamification-success: #58CC02;
  --gamification-success-bg: #E5F9DB;
  --gamification-danger: #FF4B4B;
  --gamification-danger-bg: #FFE5E5;
  --gamification-warning: #FFC800;
  --gamification-warning-bg: #FFF8DB;
  --gamification-purple: #CE82FF;
  --gamification-purple-bg: #F3E5FF;

  /* Surface & Elevation */
  --surface-page: #F7F7F7;
  --surface-card: #FFFFFF;
  --surface-hover: #E5E5E5;
  --surface-active: #1A5FA8;

  /* shadcn/ui compatible mappings */
  --background: oklch(0.985 0.002 60);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary: #1A5FA8;
  --primary-foreground: #FFFFFF;
  --secondary: oklch(0.97 0.005 60);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0.005 60);
  --muted-foreground: oklch(0.5 0.01 60);
  --accent: #E8F0FA;
  --accent-foreground: oklch(0.205 0 0);
  --destructive: #FF4B4B;
  --border: oklch(0.92 0.005 60);
  --input: oklch(0.92 0.005 60);
  --ring: #1A5FA8;
  --chart-1: #1A5FA8;
  --chart-2: #58CC02;
  --chart-3: #FFC800;
  --chart-4: #FF4B4B;
  --chart-5: #CE82FF;
  --sidebar: oklch(0.985 0.002 60);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: #1A5FA8;
  --sidebar-primary-foreground: #FFFFFF;
  --sidebar-accent: #E8F0FA;
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.92 0.005 60);
  --sidebar-ring: #1A5FA8;
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "ss01", "ss03";
  }
  ::selection {
    background: rgba(28, 176, 246, 0.2);
  }
}

/* ═══════════════════════════════════════════════════════════
   Chinese & Arabic Font Classes
   ═══════════════════════════════════════════════════════════ */
.font-chinese-serif {
  font-family: var(--font-noto-serif-sc), 'Noto Serif SC', serif;
}

.font-chinese-sans {
  font-family: var(--font-noto-sans-sc), 'Noto Sans SC', sans-serif;
}

.font-arabic {
  font-family: var(--font-tajawal), 'Tajawal', sans-serif;
}

/* ═══════════════════════════════════════════════════════════
   Flashcard Flip Animation
   ═══════════════════════════════════════════════════════════ */
.perspective-1000 {
  perspective: 1000px;
}

.preserve-3d {
  transform-style: preserve-3d;
}

.backface-hidden {
  backface-visibility: hidden;
}

.rotate-y-180 {
  transform: rotateY(180deg);
}

/* ═══════════════════════════════════════════════════════════
   Scrollbar Styling
   ═══════════════════════════════════════════════════════════ */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: oklch(0.8 0.01 60);
  border-radius: 3px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: oklch(0.65 0.02 60);
}

.scrollbar-none {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-none::-webkit-scrollbar {
  display: none;
}

/* ═══════════════════════════════════════════════════════════
   Gamification Animations
   ═══════════════════════════════════════════════════════════ */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in-up {
  animation: fadeInUp 0.4s ease-out;
}

@keyframes pulse-correct {
  0%, 100% { box-shadow: 0 0 0 0 rgba(88, 204, 2, 0.4); }
  50% { box-shadow: 0 0 0 10px rgba(88, 204, 2, 0); }
}

@keyframes pulse-wrong {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 75, 75, 0.4); }
  50% { box-shadow: 0 0 0 10px rgba(255, 75, 75, 0); }
}

.animate-pulse-correct {
  animation: pulse-correct 0.6s ease-out;
}

.animate-pulse-wrong {
  animation: pulse-wrong 0.6s ease-out;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.shimmer {
  background: linear-gradient(90deg, transparent, rgba(26, 95, 168, 0.08), transparent);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

/* XP Pop Animation */
@keyframes xp-pop {
  0% { transform: scale(0) translateY(0); opacity: 1; }
  50% { transform: scale(1.2) translateY(-10px); opacity: 1; }
  100% { transform: scale(1) translateY(-30px); opacity: 0; }
}

.animate-xp-pop {
  animation: xp-pop 1s ease-out forwards;
}

/* Streak Fire Animation */
@keyframes streak-glow {
  0%, 100% { filter: drop-shadow(0 0 4px rgba(255, 200, 0, 0.3)); }
  50% { filter: drop-shadow(0 0 8px rgba(255, 200, 0, 0.6)); }
}

.animate-streak-glow {
  animation: streak-glow 2s ease-in-out infinite;
}

/* ═══════════════════════════════════════════════════════════
   Card Hover Effects — Duolingo Style
   ═══════════════════════════════════════════════════════════ */
.card-hover {
  transition: all 0.2s ease;
}

.card-hover:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

/* Duolingo button style */
.btn-primary-game {
  background: #1A5FA8;
  color: white;
  border: none;
  border-bottom: 4px solid #0D4E82;
  border-radius: 16px;
  padding: 12px 24px;
  font-weight: 700;
  transition: all 0.1s ease;
  cursor: pointer;
}

.btn-primary-game:hover {
  background: #1A5FA8;
  border-bottom-width: 2px;
  transform: translateY(1px);
}

.btn-primary-game:active {
  border-bottom-width: 0;
  transform: translateY(3px);
}

.btn-secondary-game {
  background: white;
  color: #1A5FA8;
  border: 2px solid #1A5FA8;
  border-bottom: 4px solid #1A5FA8;
  border-radius: 16px;
  padding: 12px 24px;
  font-weight: 700;
  transition: all 0.1s ease;
  cursor: pointer;
}

.btn-secondary-game:hover {
  background: #E8F0FA;
  border-bottom-width: 2px;
}

.btn-success-game {
  background: #58CC02;
  color: white;
  border: none;
  border-bottom: 4px solid #46A302;
  border-radius: 16px;
  padding: 12px 24px;
  font-weight: 700;
  transition: all 0.1s ease;
  cursor: pointer;
}

.btn-success-game:hover {
  border-bottom-width: 2px;
  transform: translateY(1px);
}

.btn-success-game:active {
  border-bottom-width: 0;
}

/* ═══════════════════════════════════════════════════════════
   RTL Specific
   ═══════════════════════════════════════════════════════════ */
[dir="rtl"] .flip-card {
  transform: rotateY(180deg);
}

/* ═══════════════════════════════════════════════════════════
   Progress Bar — Duolingo Style
   ═══════════════════════════════════════════════════════════ */
.progress-duo {
  height: 20px;
  background: #E5E5E5;
  border-radius: 10px;
  overflow: hidden;
}

.progress-duo-fill {
  height: 100%;
  background: #58CC02;
  border-radius: 10px;
  border-bottom: 4px solid #46A302;
  transition: width 0.5s ease;
}

/* Dark variant for sidebar */
.sidebar-progress .progress-duo {
  background: rgba(255,255,255,0.08);
  height: 6px;
  border-radius: 10px;
}
.sidebar-progress .progress-duo-fill {
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  border-bottom: none;
  border-radius: 10px;
}

/* ═══════════════════════════════════════════════════════════
   Pomodoro Timer Styles
   ═══════════════════════════════════════════════════════════ */
@keyframes timer-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.pomodoro-active {
  animation: timer-pulse 2s ease-in-out infinite;
}

.pomodoro-ring {
  transition: stroke-dashoffset 1s linear;
}

/* ═══════════════════════════════════════════════════════════
   Swipe Gesture Flashcard Styles
   ═══════════════════════════════════════════════════════════ */
.flashcard-container {
  touch-action: pan-y;
}

.flashcard-swipe-left {
  animation: swipe-left 0.3s ease-out;
}

.flashcard-swipe-right {
  animation: swipe-right 0.3s ease-out;
}

@keyframes swipe-left {
  to { transform: translateX(-120%) rotate(-10deg); opacity: 0; }
}

@keyframes swipe-right {
  to { transform: translateX(120%) rotate(10deg); opacity: 0; }
}

/* ═══════════════════════════════════════════════════════════
   Safe Area Bottom — Mobile
   ═══════════════════════════════════════════════════════════ */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

/* ═══════════════════════════════════════════════════════════
   Quizlet-Style Card Stack
   ═══════════════════════════════════════════════════════════ */
.quizlet-stack {
  perspective: 1200px;
}

.quizlet-card {
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.quizlet-card.flipped {
  transform: rotateY(180deg);
}

.quizlet-card-face {
  backface-visibility: hidden;
  position: absolute;
  inset: 0;
}

.quizlet-card-back {
  transform: rotateY(180deg);
}

/* Confetti animation */
@keyframes confetti-fall {
  0% { transform: translateY(-100%) rotate(0deg); opacity: 1; }
  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

.confetti-piece {
  animation: confetti-fall 3s ease-in forwards;
}
